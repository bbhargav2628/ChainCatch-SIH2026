# Copy this file to `.env` in the same folder (backend/.env) and fill in
# your own keys. `.env` is git-ignored — never commit real keys.

# Etherscan API V2 key (required for LIVE MODE / Ethereum).
# Get one free at https://etherscan.io/register -> https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=

# TRONSCAN API key (optional for LIVE MODE / TRON — TRONSCAN's public
# endpoints work without a key at a lower rate limit).
# See https://docs.tronscan.org/ for how to request one.
TRONSCAN_API_KEY=

# Bounded multi-hop tracing limits (see live_tracing.py)
MAX_HOPS=4
MAX_WALLETS=100
MAX_TRANSACTIONS_PER_WALLET=100

# Live-lookup cache TTL, in seconds
CACHE_TTL_SECONDS=300

# Per-request timeout to the blockchain APIs, in seconds
REQUEST_TIMEOUT_SECONDS=10
